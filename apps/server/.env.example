PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Optional. Set to a Redis connection string (e.g. from Vercel Marketplace /
# Upstash Redis, or any standard Redis instance) to make rate limiting
# consistent across multiple server instances. Leave unset for local dev or
# a single-instance deployment - rate limiting falls back to in-memory and
# everything else behaves identically. Never used for chat content: rooms,
# users, and messages always stay in-memory only. See DEPLOYMENT.md.
# REDIS_URL=rediss://default:<password>@<host>:<port>
